# ── Required ───────────────────────────────────────────────────────────────
# The admin password. It always works as a backup, even if you switch
# sign-in to a PIN or passkey. Changing it signs out every device.
ADMIN_PASSWORD=change-me-to-something-long

# ── Optional ───────────────────────────────────────────────────────────────
# Port on your machine that Fyle listens on (docker compose).
HOST_PORT=8080

# The public address of Fyle, e.g. https://files.example.com
# Used for the links you copy and for passkeys. Leave blank to use whatever
# address you open Fyle on.
PUBLIC_URL=

# Maximum size of a single file, in MB.
MAX_UPLOAD_MB=500

# Behind a reverse proxy (Nginx, Caddy, Traefik, Cloudflare Tunnel)? Set this
# to the number of proxies in front of Fyle — usually 1 — so it sees real
# visitor IPs (for login rate limiting) and knows when you're on HTTPS.
TRUST_PROXY=

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# User and group that own ./data on the host (Linux bind mounts).
PUID=1000
PGID=1000
